set global sort_buffer_size=1024*32;
set optimizer_switch='index_merge_sort_intersection=on';
# test how index intersection works with a small sort buffer
select @@sort_buffer_size;
@@sort_buffer_size
32768
# intersect of primary and secondary indeces over 2 sargable ranges
